# Production Environment Variables for Frontend
# IMPORTANT: Do not commit actual .env.production file to version control
# Copy this file to .env.production and fill in actual values

# Backend API URL (required, must start with PUBLIC_)
PUBLIC_API_URL=https://your-api-domain.com

# Optional: Application settings
PUBLIC_APP_NAME=Task Manager
PUBLIC_APP_VERSION=1.0.0

# Optional: Feature flags
PUBLIC_ENABLE_ANALYTICS=true
PUBLIC_ENABLE_EXPORT=true
PUBLIC_ENABLE_BULK_OPERATIONS=true

# Optional: Third-party services
PUBLIC_SENTRY_DSN=your-sentry-dsn-if-using-error-tracking
PUBLIC_GOOGLE_ANALYTICS_ID=your-ga-id-if-using-analytics

# Optional: UI Settings
PUBLIC_DEFAULT_PAGE_SIZE=20
PUBLIC_MAX_FILE_SIZE=10485760
PUBLIC_SUPPORTED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Optional: Timezone settings
PUBLIC_DEFAULT_TIMEZONE=UTC
PUBLIC_ENABLE_TIMEZONE_DETECTION=true
